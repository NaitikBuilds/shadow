            self.observer.set_mode(mode)
        self.memory.log_activity("mode_change", mode)

    # ---------- observer lifecycle ----------

    def _start_observer(self):
        from shadow.config import perception_config

        pcfg = perception_config(self.config)
        if not pcfg.get("enabled", True):
            self.observer_status.setText("Observer: disabled in config")
            return
        self.observer = ObservationWorker(
            self.memory,
            self.backend,
            self.config,
            vision_service=self.vision_service,
        )
        self.observer.tick.connect(self._on_observer_tick)
        self.observer.observation.connect(self._on_observer_observation)
        self.observer.skipped.connect(self._on_observer_skipped)
        self.observer.error.connect(self._on_observer_error)
        self.observer.start()
        self.observer.visual_content_maybe.connect(self._on_visual_content_maybe)
        self.observer_status.setText("Observer: starting…")
        self.memory.log_activity("observer_start", "observer loop started")

    def _on_observer_tick(self, count: int):
        self.observer_status.setText(f"Observer: tick {count}")

    def _on_observer_observation(self, source: str, preview: str):
        self.observer_status.setText(f"Observer: recorded from {source}")
        self.memory.log_activity("observation", f"{source}: {preview[:80]}")

    def _on_observer_skipped(self, reason: str, detail: str):
        self.observer_status.setText(f"Observer: skipped ({reason})")

    def _on_observer_error(self, message: str):
        self.observer_status.setText(f"Observer error: {message[:80]}")
        self.memory.log_activity("observer_error", message[:120])

    def _refresh_route_chip(self):
        """Update the route chip based on backend info."""
        try:
            info = self.backend.info if hasattr(self.backend, "info") else {}
        except Exception:
            info = {}

        backend_name = info.get("backend", "cpu")
        route = info.get("route", "local")
        online = info.get("online")

        if backend_name == "hybrid":
            if not online:
                text, color, bg = "Route: Local (offline)", "#fff", "#e67e22"
            elif route == "cloud":
                text, color, bg = "Route: Cloud", "#fff", "#2ecc71"
            elif route == "local_fallback":
                text, color, bg = "Route: Local (fallback)", "#fff", "#e74c3c"
            elif route == "local_offline":
                text, color, bg = "Route: Local", "#333", "#ddd"
            else:
                text, color, bg = "Route: —", "#333", "#eee"
        else:
            text, color, bg = "Route: Local (CPU)", "#333", "#ddd"

        self.route_chip.setText(text)
        self.route_chip.setStyleSheet(
            f"padding: 2px 8px; border-radius: 8px; "
            f"background-color: {bg}; color: {color}; font-size: 11px;"
        )

    def _on_quick_capture(self, path: str):
        try:
            if hasattr(self, "tray"):
                self.tray.tray.showMessage(
                    "SHADOW — Captured",
                    path,
                )
        except Exception:
            pass
        try:
            self.memory.log_activity("quick_capture", path)
        except Exception:
            pass

    def _on_visual_content_maybe(self, payload: dict):
        if self.screen_vision is None:
            return
        if not self.vision_offer_policy.should_offer(
            payload.get("process", ""),
            payload.get("category", ""),
        ):
            return
        self._pending_vision_offer = payload
        self.vision_popup.show_for(payload)

    def _on_vision_choice(self, choice: str):
        process = self._pending_vision_offer.get("process", "")
        try:
            self.vision_offer_policy.record(process, choice)
        except Exception:
            pass

        if choice == "yes":
            self._run_vision_now()

    def _run_vision_now(self):
        if self.screen_vision is None:
            self.output.append(
                "<i>Vision is not available. Enable it in Settings → Vision.</i>"
            )
            return

        if not self._ensure_vision_consent():
            return

        # Check if the active window is excluded before attempting to sample
        try:
            from shadow.perception.active_window import ActiveWindowSource

            window = ActiveWindowSource().sample()
            if window and self.screen_vision.exclusions:
                if self.screen_vision.exclusions.is_excluded(window.get("process", "")):
                    self.output.append(
                        "<i>Vision is disabled for this application.</i>"
                    )
                    return
        except Exception:
            pass

        self.output.append("<i>Analyzing current window…</i>")
        self.indicator.set_vision_active(True)
        try:
            result = self.screen_vision.sample(task="caption", authorized=True)
        finally:
            self.indicator.set_vision_active(False)
        if not result:
            self.output.append(
                "<i>Vision returned no result "
                "(sensitive window, empty content, or model unavailable).</i>"
            )
            return

        self.output.append(f"<b>Vision:</b> {result['text']}")

        try:
            from shadow.memory import ImageObservationStore

            store = ImageObservationStore(self.memory)
            store.record_screen_vision(
                text=result.get("text", ""),
                window_title=result.get("window_title", ""),
                process=result.get("process", ""),
                task=result.get("task", "caption"),
            )
        except Exception:
            pass

        try:
            self.memory.log_activity(
                "vision_caption",
                f"{result.get('process', '')}: {result['text'][:80]}",
            )
        except Exception:
            pass

    # ---------- query flow ----------

    def send_query(self):
        try:
            self._send_query_inner()
        except Exception:
            import traceback

            tb = traceback.format_exc()
            print(tb, file=sys.stderr)
            self.output.append(f"<b style='color:red'>Exception:</b><pre>{tb}</pre>")

    def _send_query_inner(self):
        if self._shutting_down:
            return
        if self.worker is not None and self.worker.isRunning():
            return
        prompt = self.input.text().strip()
        if not prompt:
            return
        self.input.clear()

        try:
            self.taint.remember_user_input(prompt)
        except Exception:
            pass

        vision_augmented, vision_fired = self._maybe_augment_with_vision(prompt)
        if vision_fired:
            augmented = vision_augmented
            self.output.append("<i>Looking at your screen…</i>")
        else:
            augmented = self._build_prompt_with_context(prompt)

        self.output.append(f"<b>You:</b> {prompt}")
        self.output.append("<b>Shadow:</b> ")

        mode = self.mode_combo.currentText()
        max_tokens = self.config["modes"][mode]["model_max_tokens"]

        self.worker = InferenceWorker(self.backend, augmented, max_tokens)
        self.worker.chunk.connect(self.on_chunk)
        self.worker.done.connect(self.on_done)
        self.worker.failed.connect(self.on_error)
        self.worker.start()

    def on_chunk(self, text: str):
        cursor = self.output.textCursor()
        cursor.movePosition(QTextCursor.MoveOperation.End)
        cursor.insertText(text)
        self.output.setTextCursor(cursor)
        self.output.ensureCursorVisible()

    def on_done(self):
        if self._shutting_down:
            return
        self.output.append("")
        self.memory.log_activity("query", "completed")
        self._refresh_route_chip()

    def on_error(self, message: str):
        if self._shutting_down:
            return
        self.output.append(f"<b style='color:red'>Error:</b> {message}")
        self.memory.log_activity("error", message[:120])
        self._refresh_route_chip()

    def wipe_shadow(self):
        self.memory.wipe()
        self.output.append("<b>Shadow:</b> All local memory wiped.")
        self.memory.log_activity("wipe", "Full Shadow wipe executed")

    def _build_prompt_with_context(self, user_prompt: str) -> str:
        observations = []
        try:
            observations = self.retriever.semantic(user_prompt, k=3)
        except Exception:
            observations = []

        session_extra = ""
        try:
            current = self.session_memory.current_session()
            if current is not None:
                session_extra = self.session_memory.resume_summary(current)
        except Exception:
            session_extra = ""

        temporal_extra = ""
        for window in ("last month", "yesterday", "last week", "today"):
            if window in user_prompt.lower():
                try:
                    temporal = self.retriever.temporal(window)
                except Exception:
                    temporal = []
                if temporal:
                    lines = [
                        f"- [{o['timestamp']}] {o['content'][:150]}"
                        for o in temporal[:5]
                    ]
                    temporal_extra = f"Observations from {window}:\n" + "\n".join(lines)
                break

        combined_extra = "\n\n".join(
            part for part in (session_extra, temporal_extra) if part
        )
        return self.prompt_builder.build(
            user_query=user_prompt,
            observations=observations,
            extra_context=combined_extra,
        )

    def _build_memory_context(self, user_prompt: str) -> str:
        """Build a memory-only context block (no vision, no user question)."""
        try:
            observations = self.retriever.semantic(user_prompt, k=3)
        except Exception:
            observations = []

        lines: list[str] = []
        for obs in observations:
            content = (obs.get("content") or "").strip()
            if len(content) < 25:
                continue
            lines.append(
                f"- [{obs.get('timestamp', '')}] "
                f"({obs.get('source', '')}) {content[:150]}"
            )

        # Add temporal results if a time keyword is present.
        for window in ("last month", "yesterday", "last week", "today"):
            if window in user_prompt.lower():
                try:
                    temporal = self.retriever.temporal(window)
                except Exception:
                    temporal = []
                for obs in temporal[:5]:
                    content = (obs.get("content") or "").strip()
                    if len(content) < 25:
                        continue
                    lines.append(
                        f"- [{obs.get('timestamp', '')}] "
                        f"({obs.get('source', '')}) {content[:150]}"
                    )
                break

        if not lines:
            return ""
        return "Relevant past observations:\n" + "\n".join(lines)

    def _maybe_augment_with_vision(self, user_prompt: str) -> tuple[str, bool]:
        """Detect visual intent and run vision if matched.

        Returns (augmented_prompt, vision_fired).
        """
        intent = detect_intent(user_prompt)
        if intent is None:
            return user_prompt, False

        if self.screen_vision is None:
            return user_prompt, False

        if not self._ensure_vision_consent():
            return user_prompt, False

        self.indicator.set_vision_active(True)
        try:
            result = self.screen_vision.sample(
                task=intent.task,
                prompt=intent.prompt,
                authorized=True,
            )
        except Exception:
            result = None
        finally:
            self.indicator.set_vision_active(False)

        # Persist if we got a result (best-effort)
        if result is not None:
            try:
                from shadow.memory import ImageObservationStore

                store = ImageObservationStore(self.memory)
                store.record_screen_vision(
                    text=result.get("text", ""),
                    window_title=result.get("window_title", ""),
                    process=result.get("process", ""),
                    task=result.get("task", "caption"),
                )
            except Exception:
                pass

        vision_context = build_vision_context(intent, result)

        # If the query also asks about past context, merge memory retrieval.
        memory_context = ""
        if wants_memory_context(user_prompt):
            try:
                memory_context = self._build_memory_context(user_prompt)
            except Exception:
                memory_context = ""

        combined = build_combined_context(vision_context, memory_context)
        augmented = f"{combined}\n\nUser question: {user_prompt}"
        return augmented, True

    # ---------- graceful shutdown ----------

    def closeEvent(self, event: QCloseEvent):
        if not self._full_shutdown:
            # Minimize to tray. SHADOW keeps observing.
            event.ignore()
            self.hide()
            if hasattr(self, "tray"):
                self.tray.show_minimize_hint()
            return

        self._shutting_down = True

        # Stop observer
        if self.observer is not None and self.observer.isRunning():
            self.observer.stop()
            if not self.observer.wait(3000):
                print("[shadow] observer did not stop within 3 s")

        if hasattr(self, "vision_hotkeys") and self.vision_hotkeys is not None:
            self.vision_hotkeys.stop()

        self.region_overlay.hide()

        # Stop quick capture hotkey listener
        if hasattr(self, "quick_capture"):
            self.quick_capture.stop()

        # Stop inference worker
        worker = self.worker
        if worker is not None and worker.isRunning():
            worker.requestInterruption()
            if not worker.wait(3000):
                print("[shadow] worker did not stop within 3 s")

        try:
            self.memory.log_activity("app_stop", "SHADOW closed")
        finally:
            self.memory.close()

        if hasattr(self, "tray"):
            self.tray.hide()

        event.accept()
